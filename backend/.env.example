# CiviSight AI — Backend Environment Configuration
#
# Copy this file to backend/.env and edit as needed.
# Never commit backend/.env — it is git-ignored.
#
# For production (Render), set these as environment variables in the
# Render dashboard instead of using a .env file.

# Application environment: development | production
APP_ENV=development

# Comma-separated allowed CORS origins.
# In production, replace the placeholder with your actual Vercel URL.
# Example: http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum image upload size in MB (Render free: keep ≤ 10 MB)
MAX_UPLOAD_MB=10

# Maximum image dimension in pixels (larger images are downsampled)
MAX_IMAGE_DIM=1920

# Hours to retain uploaded/annotated images before automatic cleanup
# Note: Render free filesystem is ephemeral — files are lost on redeploy regardless
RETENTION_HOURS=168

# Path to model registry YAML, relative to backend/
MODEL_REGISTRY_PATH=models/registry.yaml

# Directory for temporary uploaded/annotated images, relative to backend/
STORAGE_DIR=storage

# Maximum simultaneous YOLO inference requests.
# Keep at 1 for Render Free (512 MB RAM) to avoid OOM.
MAX_CONCURRENT_INFERENCES=1

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
