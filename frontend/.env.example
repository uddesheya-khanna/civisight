# CiviSight AI — Frontend Environment Configuration
#
# Copy this file to frontend/.env and edit as needed.
# Never commit frontend/.env — it is git-ignored.
#
# For production (Vercel), set VITE_API_BASE_URL in the Vercel dashboard
# under Project Settings → Environment Variables.

# Backend API base URL.
#
# Development (leave empty):
#   Empty string → Vite dev server proxy forwards /api/* to http://localhost:8000
#   This is correct for local development — do not set a URL here.
#
# Production (Vercel):
#   Set to your Render backend URL in the Vercel dashboard:
#   VITE_API_BASE_URL=https://your-civisight-api.onrender.com
#
VITE_API_BASE_URL=
